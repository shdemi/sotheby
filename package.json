{
  "name": "sothebys-mansion-tooling",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling for the data editor tests. The app itself has no dependencies and no build step.",
  "scripts": {
    "test": "node editor/_test/run-all.mjs",
    "test:ui": "node editor/_test/ui.test.mjs",
    "serve": "python serve.py 8000",
    "sync": "node scripts/sync/index.mjs",
    "sync:verify": "node scripts/sync/verify.mjs",
    "sync:assets": "node scripts/sync/assets.mjs",
    "sync:prune": "node scripts/sync/tools/prune-images.mjs",
    "codes:snapshot": "node scripts/codes/snapshot.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "dependencies": {
    "@vercel/og": "0.6.8"
  }
}
